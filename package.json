{
  "name": "pokemon-rest",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @pokemon-rest/web",
    "dev:api": "npm run dev --workspace @pokemon-rest/api",
    "seed": "npm run seed --workspace @pokemon-rest/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ts-check": "tsc -b --force"
  }
}
