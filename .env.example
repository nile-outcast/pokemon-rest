# Postgres для docker-compose (имена переменных подхватывает compose)
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
POSTGRES_DB=pokemon_rest
POSTGRES_PORT=5432

# apps/api
# DATABASE_URL собирается из значений Postgres выше
DATABASE_URL=postgres://pokemon:pokemon@localhost:5432/pokemon_rest
HOST=127.0.0.1
PORT=3000

# PokeAPI (используется сидером)
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
